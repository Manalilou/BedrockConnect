{
  "_comment": "Configuration centralisée des serveurs — src/main/resources/servers-config.json",
  "_comment2": "Rebuild requis après modification : mvn clean package (dans le dossier serverlist-server/)",

  "user_menu": {
    "name": "Mes Serveurs",
    "image": "https://i.imgur.com/nhumQVP.png"
  },

  "_maintenance_guide": {
    "ajouter_serveur_direct": [
      "1. Copier le bloc _template_serveur dans 'featured' ou 'other'",
      "2. Remplir name, address, port, image",
      "3. mvn clean package"
    ],
    "ajouter_groupe": [
      "1. Copier le bloc _template_groupe dans 'featured'",
      "2. Le bouton affichera un sous-menu avec les serveurs du groupe",
      "3. mvn clean package"
    ],
    "desactiver_entree": "Ajouter '\"enabled\": false' — ignoré au chargement sans être supprimé"
  },

  "_field_reference": {
    "id":       "Identifiant unique snake_case — utilisé dans les logs",
    "name":     "Nom affiché in-game",
    "address":  "IP ou hostname (serveur direct uniquement)",
    "port":     "Port UDP Bedrock (défaut : 19132, serveur direct uniquement)",
    "image":    "URL de l'icône (PNG, 64x64 recommandé)",
    "enabled":  "true/false — désactiver sans supprimer (défaut : true)",
    "servers":  "Tableau de serveurs directs → transforme l'entrée en GROUPE (sous-menu)"
  },

  "_template_serveur_direct": {
